# Copiar a .env y ajustar. El .env no se versiona.
#
# IP o nombre por el que el móvil accede a la PWA. Con la CA interna de Caddy
# puede ser una IP privada; el certificado incluye esa IP como SAN.
SIGNBB_DOMINIO=192.168.20.217

# Backend visto desde Caddy. Con network_mode: host, es el localhost del host.
SIGNBB_BACKEND=127.0.0.1:8080
