# =============================================================================
# Variables del despliegue público de SignBB
# =============================================================================
# Copiar a .env, completar los valores y proteger el archivo:
#   cp .env.prod.example .env
#   chmod 600 .env
#
# .env no se versiona (ya está en .gitignore). No lo subas al repositorio.
#
# Genera los secretos con:
#   openssl rand -base64 48   # JWT (mínimo 32 bytes)
#   openssl rand -base64 24   # contraseñas y clave secreta de Silo
#   openssl rand -hex 16      # clave de acceso de Silo (sin / + =)
# =============================================================================

# --- Dominios públicos -------------------------------------------------------
# Si no tienes dominio, usa el patrón de sslip.io:
#   consulta.<IP-PUBLICA>.sslip.io
#   autoria.<IP-PUBLICA>.sslip.io
SIGNBB_DOMINIO_CONSULTA=consulta.example.com
SIGNBB_DOMINIO_AUTORIA=autoria.example.com

# El destino del proxy se fija en compose.prod.yaml como backend:8080.

# --- Entorno y funciones de desarrollo --------------------------------------
SIGNBB_ENTORNO=produccion
SIGNBB_DOCS_ACTIVAS=false
SIGNBB_SHOW_SQL=false
SIGNBB_DEMO_ACTIVA=false

# --- Secretos obligatorios ---------------------------------------------------
# El backend no arranca en producción si conservan los valores de ejemplo.
SIGNBB_DB_CONTRASENA=CAMBIA_ESTO
SIGNBB_JWT_SECRETO=CAMBIA_ESTO
SIGNBB_SUPERVISOR_CONTRASENA=CAMBIA_ESTO
SIGNBB_MEDIA_ACCESS_KEY=CAMBIA_ESTO
SIGNBB_MEDIA_SECRET_KEY=CAMBIA_ESTO

# --- CORS y proxy inverso ----------------------------------------------------
# Incluye exactamente los dos orígenes públicos, con https://.
SIGNBB_CORS_ORIGENES=https://consulta.example.com,https://autoria.example.com
SERVER_FORWARD_HEADERS_STRATEGY=framework

# --- Siembra inicial ---------------------------------------------------------
# En el primer arranque deja la siembra del grafo raíz en true. Cuando termine,
# cámbiala a false y recrea el backend.
SIGNBB_SIEMBRA_ACTIVA=true

# El seed de demo crea el médico, el padre y los cuatro subgrafos de ejemplo.
# Úsalo solo en la ventana de demostración y con contraseñas propias.
# Después de la primera siembra, cámbialo a false.
SIGNBB_SEED_DEMO_ACTIVA=true

# --- Datos del seed de demo (solo si SIGNBB_SEED_DEMO_ACTIVA=true) ----------
SIGNBB_SEED_MEDICO_NOMBRE=Médico ejemplo - Neonatologo
SIGNBB_SEED_MEDICO_CORREO=medico.ejemplo@signbb.local
SIGNBB_SEED_MEDICO_CONTRASENA=CAMBIA_ESTO
SIGNBB_SEED_MEDICO_INSTITUCION=Fundación Canguro

SIGNBB_SEED_PADRE_NOMBRE=Padre ejemplo
SIGNBB_SEED_PADRE_CORREO=padre.ejemplo@signbb.local
SIGNBB_SEED_PADRE_CONTRASENA=CAMBIA_ESTO

# --- Opcionales --------------------------------------------------------------
# Modo del despliegue con Cloudflare Tunnel (solo para compose.tunnel.yaml):
#   tunnel        dos hostnames propios (Caddyfile.tunnel)
#   quick-tunnel  un hostname aleatorio y autoría bajo /autoria/
# SIGNBB_TUNNEL_MODE=tunnel

# Subpath de ui-autoria. Para Cloudflare Quick Tunnel usar /autoria/.
# AUTORIA_BASE_HREF=/

# Usuario y correo del supervisor inicial. La contraseña es obligatoria arriba.
# SIGNBB_SUPERVISOR_NOMBRE=Supervisor SignBB
# SIGNBB_SUPERVISOR_CORREO=supervisor@signbb.local

# Bucket de imágenes en Silo. El backend lo crea en el primer uso.
# SIGNBB_MEDIA_BUCKET=signbb-imagenes

# Tamaño del pool de conexiones a PostgreSQL (por defecto 10).
# SIGNBB_DB_POOL_MAX=10
