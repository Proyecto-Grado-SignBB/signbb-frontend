# =============================================================================
# Caddy para un Cloudflare Quick Tunnel (sin dominio propio)
# =============================================================================
# - Un único hostname aleatorio *.trycloudflare.com.
# - ui-consulta se sirve en la raíz.
# - ui-autoria se sirve bajo /autoria/; debe compilarse con
#   --base-href /autoria/ (el Dockerfile acepta AUTORIA_BASE_HREF).
# - Caddy escucha solo en HTTP :80; Cloudflare termina el TLS.
#
# Este archivo se monta con SIGNBB_TUNNEL_MODE=quick-tunnel en
# compose.tunnel.yaml.
# =============================================================================
{
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api /api/*
	@media path /media /media/*
	@health path /actuator/health
	@sinCache path / /index.html /ngsw-worker.js /ngsw.json /safety-worker.js /manifest.webmanifest

	header @sinCache Cache-Control "no-cache"
	header @api Cache-Control "no-store"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	handle @api {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			# cloudflared habla HTTP con Caddy, pero el navegador usa HTTPS.
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle @media {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle @health {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	# /autoria sin barra final: redirigir para que el base href funcione.
	redir /autoria /autoria/ 308

	handle_path /autoria/* {
		header Cache-Control "no-cache"
		root * /srv-autoria
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv-consulta
		try_files {path} /index.html
		file_server
	}
}
