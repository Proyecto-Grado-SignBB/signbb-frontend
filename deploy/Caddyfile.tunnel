# =============================================================================
# Caddy para el despliegue con Cloudflare Tunnel (hostnames propios)
# =============================================================================
# - Caddy escucha solo en HTTP :80; Cloudflare termina el TLS en el borde.
# - cloudflared envía el Host original, así que cada sitio se resuelve por
#   hostname.
# - No se usa "tls internal" ni se intenta obtener un certificado: el túnel
#   ya transporta el tráfico cifrado hasta Cloudflare.
#
# Variables:
#   SIGNBB_DOMINIO_CONSULTA  hostname público de la PWA de consulta
#   SIGNBB_DOMINIO_AUTORIA   hostname público de la aplicación de autoría
#   SIGNBB_BACKEND           destino del proxy (por defecto backend:8080)
# =============================================================================
{
	auto_https off
}

{$SIGNBB_DOMINIO_CONSULTA}:80 {
	encode zstd gzip

	@api path /api /api/*
	@media path /media /media/*
	@health path /actuator/health
	@sinCache path / /index.html /ngsw-worker.js /ngsw.json /safety-worker.js /manifest.webmanifest

	header @sinCache Cache-Control "no-cache"
	header @api Cache-Control "no-store"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	handle @api {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			# cloudflared habla HTTP con Caddy, pero el navegador usa HTTPS.
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle @media {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle @health {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		root * /srv-consulta
		try_files {path} /index.html
		file_server
	}
}

{$SIGNBB_DOMINIO_AUTORIA}:80 {
	encode zstd gzip

	@api path /api /api/*
	@media path /media /media/*
	@sinCache path / /index.html

	header @sinCache Cache-Control "no-cache"
	header @api Cache-Control "no-store"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	handle @api {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle @media {
		reverse_proxy {$SIGNBB_BACKEND:backend:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		root * /srv-autoria
		try_files {path} /index.html
		file_server
	}
}
