<div class="pantalla-autoria">
  <app-sidebar-autoria [grafoId]="grafoId" seccionActiva="grafos" />

  <div class="main">
    <div class="topbar">
      <div class="topbar-left">
        <div class="crumb crumb--clicable" (click)="volverAlTablero()">Grafos clínicos</div>
        <h3>
          {{ nombreGrafo() }}
          @if (estadoGrafo() === 'Borrador') {
            <app-etiqueta tono="aviso">Borrador sin publicar</app-etiqueta>
          } @else {
            <app-etiqueta tono="calma">Publicado</app-etiqueta>
          }
        </h3>
      </div>
      <div class="topbar-right">
        <app-boton tono="neutro" variante="contorno" alto="compacto" ancho="auto" [disabled]="guardando()" (click)="guardar()">{{ guardando() ? 'Guardando…' : 'Guardar' }}</app-boton>
        <app-boton tono="marca" alto="compacto" ancho="auto" [disabled]="publicando()" (click)="abrirConfirmarPublicar()">Publicar</app-boton>
      </div>
    </div>

    <div class="content">
      @if (error()) {
        <app-mensaje-error [texto]="error()!" (reintentar)="cargarGrafo()" />
      }

      @if (mensajePublicacion()) {
        <div class="aviso-publicacion">{{ mensajePublicacion() }}</div>
      }

      @if (cargando()) {
        <p class="estado-carga">Cargando flujo…</p>
      } @else {
        <div class="flow-toolhint">
          <p>Cada tarjeta es una pregunta o un desenlace. La edición puntual de preguntas llega en la siguiente pantalla.</p>
        </div>

        @if (columnas().length === 0 && huerfanos().length === 0) {
          <p class="estado-vacio">Este grafo todavía no tiene preguntas. Agrega la primera con el botón de abajo.</p>
        } @else {
          @if (menuAbiertoId()) {
            <div class="menu-backdrop" (click)="cerrarMenu()"></div>
          }
          <div class="flow">
            @for (columna of columnas(); track $index) {
              <div class="flow-col">
                @for (nodo of columna; track nodo.id) {
                  <ng-container *ngTemplateOutlet="tarjetaNodo; context: { nodo: nodo }" />
                }
              </div>
            }
          </div>

          @if (huerfanos().length > 0) {
            <div class="orphan-wrap">
              <div class="flag">Sin conectar — nadie del flujo lleva hasta aquí</div>
              @for (nodo of huerfanos(); track nodo.id) {
                <ng-container *ngTemplateOutlet="tarjetaNodo; context: { nodo: nodo, orfano: true }" />
              }
            </div>
          }

          @if (hayCiclos()) {
            <p class="aviso-ciclo">Este grafo tiene ciclos: alguna secuencia de respuestas puede repetirse sin llegar nunca a un desenlace.</p>
          }
        }

        <div class="fab-group">
          <div class="fab fab--secundario" (click)="agregarDesenlace()">+ Agregar desenlace</div>
          <div class="fab" (click)="agregarPregunta()">+ Agregar pregunta</div>
        </div>
      }

      <ng-template #tarjetaNodo let-nodo="nodo" let-orfano="orfano">
        <div
          class="node"
          [class.node--orphan]="orfano"
          [class.node--outcome]="nodo.esDesenlace"
          [class.node--urgent]="nodo.severidad === 'urgent'"
          [class.node--priority]="nodo.severidad === 'priority'"
          [class.node--editable]="puedeEditar(nodo)"
          [attr.title]="puedeEditar(nodo) ? (nodo.esDesenlace ? 'Editar este desenlace' : 'Editar esta pregunta') : null"
          (click)="abrirNodo(nodo)">
          @if (nodo.tipo === 'inicio') {
            <span class="tag-inicio">Inicio del recorrido</span>
          }
          @if (puedeEditar(nodo)) {
            <div class="node-menu">
              <button
                type="button"
                class="btn-menu-nodo"
                title="Más acciones"
                (click)="toggleMenu(nodo.id, $event)">⋮</button>
              @if (menuAbiertoId() === nodo.id) {
                <div class="menu-flotante" (click)="$event.stopPropagation()">
                  <button type="button" (click)="abrirNodo(nodo)">{{ nodo.esDesenlace ? 'Editar desenlace' : 'Editar pregunta' }}</button>
                  @if (nodo.tipo === 'pregunta') {
                    <button type="button" (click)="marcarComoInicio(nodo)">Marcar como inicio</button>
                  }
                  @if (nodo.tipo === 'pregunta') {
                    <button type="button" class="opcion-peligro" [disabled]="eliminando()" (click)="eliminarPregunta(nodo)">{{ eliminando() ? 'Eliminando…' : 'Eliminar' }}</button>
                  } @else if (nodo.esDesenlace) {
                    <button type="button" class="opcion-peligro" [disabled]="eliminando()" (click)="eliminarDesenlace(nodo)">{{ eliminando() ? 'Eliminando…' : 'Eliminar' }}</button>
                  }
                </div>
              }
            </div>
          }
          <div class="kind">{{ nodo.kind }}</div>
          <p>{{ nodo.texto }}</p>
        </div>
      </ng-template>
    </div>
  </div>

  @if (mostrarConfirmarPublicar()) {
    <app-modal-publicar
      [nombreGrafo]="nombreGrafo()"
      [conteoPreguntas]="conteoPreguntas()"
      [conteoReglas]="conteoReglas()"
      [validacion]="validacionParaPublicar()"
      [validando]="validandoPublicar()"
      [publicando]="publicando()"
      (confirmar)="publicar()"
      (cancelar)="cerrarConfirmarPublicar()" />
  }
</div>
