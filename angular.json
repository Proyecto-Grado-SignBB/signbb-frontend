{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ui-consulta": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ui-consulta",
      "sourceRoot": "projects/ui-consulta/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ui-consulta/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ui-consulta/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ui-consulta/public"
              }
            ],
            "styles": [
              "projects/ui-consulta/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/ui-compartida/src/styles"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/ui-consulta/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/ui-consulta/src/environments/environment.ts",
                  "with": "projects/ui-consulta/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ui-consulta:build:production"
            },
            "development": {
              "buildTarget": "ui-consulta:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/ui-consulta/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ui-consulta/public"
              }
            ],
            "styles": [
              "projects/ui-consulta/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/ui-compartida/src/styles"
              ]
            }
          }
        }
      }
    },
    "ui-compartida": {
      "projectType": "library",
      "root": "projects/ui-compartida",
      "sourceRoot": "projects/ui-compartida/src",
      "prefix": "sb",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-compartida/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-compartida/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ui-compartida/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "ui-autoria": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ui-autoria",
      "sourceRoot": "projects/ui-autoria/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ui-autoria/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ui-autoria/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ui-autoria/public"
              }
            ],
            "styles": [
              "projects/ui-autoria/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/ui-compartida/src/styles",
                "projects/ui-autoria/src/styles"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/ui-autoria/src/environments/environment.ts",
                  "with": "projects/ui-autoria/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ui-autoria:build:production"
            },
            "development": {
              "buildTarget": "ui-autoria:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4300
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/ui-autoria/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ui-autoria/public"
              }
            ],
            "styles": [
              "projects/ui-autoria/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/ui-compartida/src/styles",
                "projects/ui-autoria/src/styles"
              ]
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
